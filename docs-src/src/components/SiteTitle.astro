---
/**
 * Markenzeile in der Kopfleiste.
 *
 * Ersetzt die Vorgabe von Starlight, damit die Doku dieselbe Wortmarke traegt
 * wie eucowork.ai und daneben sichtbar "Docs" steht. Das Zeichen liegt inline
 * im Markup: es faerbt sich ueber `currentColor` mit dem Thema mit und braucht
 * weder eine zweite Datei fuer den Dunkelmodus noch einen zusaetzlichen Abruf.
 *
 * Das Logo verlinkt auf die Startseite der Website, "Docs" auf die Startseite
 * der Dokumentation in der jeweiligen Sprache.
 */
import type { Props } from '@astrojs/starlight/props';

const { locale } = Astro.props;
const docsHome = locale === 'en' ? '/docs/en' : '/docs';
---

<div class="euc-sitetitle">
  <a href="/" class="euc-wordmark" aria-label="EU Cowork AI, zur Startseite">
    <svg
      class="euc-logo"
      width="24"
      height="24"
      viewBox="0 0 26 26"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2.5 21.5 L10.5 6.5 L14.5 14 L17.5 8.5 L23.5 21.5 Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
      <circle cx="17.5" cy="5.4" r="2.1" fill="#F4C542"></circle>
    </svg>
    <span class="euc-wordmark-text">EU Cowork <span class="euc-wordmark-ai">AI</span></span>
  </a>
  <a href={docsHome} class="euc-docslabel">Docs</a>
</div>

<style>
  .euc-sitetitle {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    overflow: hidden;
  }

  .euc-wordmark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: var(--sl-text-lg);
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .euc-logo {
    flex-shrink: 0;
  }

  .euc-wordmark-ai {
    color: var(--euc-gold);
  }

  .euc-docslabel {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: var(--sl-text-base);
    font-weight: 500;
    padding-inline-start: 0.625rem;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }

  .euc-docslabel:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 30rem) {
    .euc-wordmark-text {
      display: none;
    }
  }
</style>
