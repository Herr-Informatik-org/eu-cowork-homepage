---
/**
 * Konzeptskizze: Weg einer Werkzeug-Anfrage durch die Rechtepruefung.
 *
 * Handgeschriebenes SVG statt Mermaid, gleiche Begruendung wie in
 * DiagrammArchitektur.astro. Die Beschriftungen haengen an der Sprache der
 * Seite, die Stilklassen liegen global in src/styles/eucowork.css.
 */
const en = Astro.url.pathname.startsWith('/docs/en');

const t = en
  ? {
      titel: 'How a tool request travels through the permission check',
      beschreibung:
        'A person asks a question and the model decides to call a tool. The call is checked against the permission rules before it reaches the connector. If access is denied, the person gets a plain text message and the target system never sees the request. If access is allowed, the connector queries the target system and the result goes back to the model. Either way the decision is logged.',
      frage: 'Question in the chat',
      frageSub: 'the model decides to use a tool',
      pruefung: 'Permission check',
      pruefungSub: 'every call is checked and logged',
      verweigert: 'denied',
      erlaubt: 'allowed',
      meldung: 'Message in the chat',
      meldungSub: 'the target system never sees the request',
      konnektor: 'Connector',
      konnektorSub: 'offers the tools of a target system',
      ziel: 'Target system',
      zielSub: 'its own permissions apply on top',
      ergebnis: 'Result returned to the model',
    }
  : {
      titel: 'Weg einer Werkzeug-Anfrage durch die Rechteprüfung',
      beschreibung:
        'Eine Person stellt eine Frage, das Modell ruft ein Werkzeug auf. Der Aufruf wird gegen die Rechteregeln geprüft, bevor er den Konnektor erreicht. Bei Verweigerung erhält die Person eine Klartext-Meldung, das Zielsystem sieht die Anfrage nie. Bei Erlaubnis fragt der Konnektor das Zielsystem ab und das Ergebnis geht zurück an das Modell. In beiden Fällen wird die Entscheidung protokolliert.',
      frage: 'Frage im Chat',
      frageSub: 'das Modell entscheidet, ein Werkzeug zu nutzen',
      pruefung: 'Rechteprüfung',
      pruefungSub: 'jeder Aufruf wird geprüft und protokolliert',
      verweigert: 'verweigert',
      erlaubt: 'erlaubt',
      meldung: 'Meldung im Chat',
      meldungSub: 'das Zielsystem sieht die Anfrage nicht',
      konnektor: 'Konnektor',
      konnektorSub: 'bietet die Werkzeuge eines Zielsystems an',
      ziel: 'Zielsystem',
      zielSub: 'dessen eigene Rechte gelten zusätzlich',
      ergebnis: 'Ergebnis zurück an das Modell',
    };
---

<figure class="euc-diagramm">
  <svg
    viewBox="0 0 880 450"
    role="img"
    aria-labelledby="gw-titel gw-beschreibung"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="gw-titel">{t.titel}</title>
    <desc id="gw-beschreibung">{t.beschreibung}</desc>

    <g class="d-node">
      <rect x="290" y="20" width="300" height="52" rx="10" />
      <text class="d-label" x="440" y="43">{t.frage}</text>
      <text class="d-sub" x="440" y="60">{t.frageSub}</text>
    </g>

    <path class="d-arrow" d="M440 72 L440 110" marker-end="url(#gw-pfeil)" />

    <g class="d-node d-node-accent">
      <rect x="290" y="114" width="300" height="56" rx="10" />
      <text class="d-label" x="440" y="139">{t.pruefung}</text>
      <text class="d-sub" x="440" y="156">{t.pruefungSub}</text>
    </g>

    <path class="d-arrow" d="M290 142 L190 142 L190 214" marker-end="url(#gw-pfeil)" />
    <text class="d-edge d-edge-end" x="278" y="134">{t.verweigert}</text>

    <g class="d-node d-node-deny">
      <rect x="40" y="218" width="300" height="56" rx="10" />
      <text class="d-label" x="190" y="243">{t.meldung}</text>
      <text class="d-sub" x="190" y="260">{t.meldungSub}</text>
    </g>

    <path class="d-arrow" d="M590 142 L690 142 L690 214" marker-end="url(#gw-pfeil)" />
    <text class="d-edge" x="602" y="134">{t.erlaubt}</text>

    <g class="d-node">
      <rect x="540" y="218" width="300" height="52" rx="10" />
      <text class="d-label" x="690" y="241">{t.konnektor}</text>
      <text class="d-sub" x="690" y="258">{t.konnektorSub}</text>
    </g>

    <path class="d-arrow" d="M690 270 L690 302" marker-end="url(#gw-pfeil)" />

    <g class="d-node">
      <rect x="540" y="306" width="300" height="52" rx="10" />
      <text class="d-label" x="690" y="329">{t.ziel}</text>
      <text class="d-sub" x="690" y="346">{t.zielSub}</text>
    </g>

    <path class="d-arrow" d="M540 332 L440 332 L440 380" marker-end="url(#gw-pfeil)" />

    <g class="d-node">
      <rect x="290" y="384" width="300" height="44" rx="10" />
      <text class="d-label" x="440" y="411">{t.ergebnis}</text>
    </g>

    <defs>
      <marker id="gw-pfeil" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="d-arrowhead" />
      </marker>
    </defs>
  </svg>
</figure>
